# Netlify / Cloudflare Pages headers (copied to dist/ via public/).
# Hashed Vite assets are immutable; the shell files must always revalidate.

/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
