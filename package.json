{
  "name": "arkqr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Serverless file transfer via animated QR codes. Fully client-side.",
  "scripts": {
    "dev": "vite",
    "dev:https": "node scripts/dev-https.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "gen-icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
